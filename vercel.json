{
  "buildCommand": null,
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/pages/data-analysis.html",
      "destination": "/pages/dashboard.html",
      "permanent": true
    },
    {
      "source": "/pages/payroll-attendance.html",
      "destination": "/pages/staff-accounting.html",
      "permanent": true
    },
    {
      "source": "/pages/booking-availability-admin.html",
      "destination": "/pages/bookings.html?settings=1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/assets/images/salonix-logo.svg"
    }
  ],
  "functions": {
    "api/apps-script.js": {
      "maxDuration": 180
    }
  }
}
